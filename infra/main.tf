# One stack for every environment. An environment is data only:
#   envs/<env>/backend.hcl      state location (generated by bootstrap)
#   envs/<env>/terraform.tfvars sizing and services
# The resource group is created by bootstrap, so CI identities are scoped to it.

data "azurerm_resource_group" "this" {
  name = "rg-${var.project}-${var.environment}"
}

locals {
  tags = merge(var.tags, {
    project     = var.project
    environment = var.environment
    managed_by  = "terraform"
  })
}

module "platform" {
  source = "../modules/platform"

  project                    = var.project
  environment                = var.environment
  resource_group_name        = data.azurerm_resource_group.this.name
  location                   = data.azurerm_resource_group.this.location
  acr_sku                    = var.acr_sku
  log_retention_days         = var.log_retention_days
  key_vault_soft_delete_days = var.key_vault_soft_delete_days
  key_vault_purge_protection = var.key_vault_purge_protection
  tags                       = local.tags
}

module "service" {
  source   = "../modules/container-service"
  for_each = var.services

  name                            = each.key
  environment                     = var.environment
  resource_group_name             = data.azurerm_resource_group.this.name
  location                        = data.azurerm_resource_group.this.location
  container_app_environment_id    = module.platform.container_app_environment_id
  container_registry_id           = module.platform.container_registry_id
  container_registry_login_server = module.platform.container_registry_login_server
  key_vault_id                    = module.platform.key_vault_id
  key_vault_uri                   = module.platform.key_vault_uri

  image             = each.value.image
  target_port       = each.value.target_port
  external_ingress  = each.value.external_ingress
  cpu               = each.value.cpu
  memory            = each.value.memory
  min_replicas      = each.value.min_replicas
  max_replicas      = each.value.max_replicas
  env               = each.value.env
  key_vault_secrets = each.value.key_vault_secrets
  tags              = local.tags
}
